{
  "name": "@recruitai/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "worker": "node worker.js",
    "seed:plans": "node scripts/seedSubscriptionPlans.js",
    "seed:demo": "node scripts/seedDemoAccounts.js",
    "check:env": "node scripts/checkEnv.js",
    "check:storage": "node scripts/checkStorage.js",
    "audit:cloudinary-legacy": "node scripts/auditCloudinaryLegacy.js",
    "check:mail": "node scripts/checkMail.js",
    "recover": "node scripts/accountRecovery.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:watch": "node --test --watch \"test/unit/*.test.js\"",
    "test:eval": "node test/eval/runEval.js",
    "sync:indexes": "node scripts/syncIndexes.js",
    "migrate:stages": "node scripts/migrateCandidateStages.js",
